# >>> es-wrapper initialize >>>
# Agregado automáticamente por el instalador de es-wrapper
# Para desinstalar, ejecuta: ~/.es-wrapper/uninstall.sh

_es_wrapper_prepend_path() {
    local _eswrap_dir="$HOME/.es-wrapper/bin"
    local _eswrap_path=":$PATH:"
    while [[ "$_eswrap_path" == *":$_eswrap_dir:"* ]]; do
        _eswrap_path="${_eswrap_path/:$_eswrap_dir:/:}"
    done
    if [[ -n "${NVM_BIN:-}" && -d "$NVM_BIN" ]]; then
        while [[ "$_eswrap_path" == *":$NVM_BIN:"* ]]; do
            _eswrap_path="${_eswrap_path/:$NVM_BIN:/:}"
        done
    fi
    _eswrap_path="${_eswrap_path#:}"
    _eswrap_path="${_eswrap_path%:}"
    if [[ -n "${NVM_BIN:-}" && -d "$NVM_BIN" ]]; then
        if [[ -n "$_eswrap_path" ]]; then
            export PATH="$_eswrap_dir:$NVM_BIN:$_eswrap_path"
        else
            export PATH="$_eswrap_dir:$NVM_BIN"
        fi
    elif [[ -n "$_eswrap_path" ]]; then
        export PATH="$_eswrap_dir:$_eswrap_path"
    else
        export PATH="$_eswrap_dir"
    fi
}
_es_wrapper_prepend_path

unalias source 2>/dev/null
unalias . 2>/dev/null
source() {
    builtin source "$@"
    local ret=$?
    if [[ -n "$VIRTUAL_ENV" ]]; then
        _es_wrapper_prepend_path
    fi
    return $ret
}
alias .='source'

_es_wrapper_guard() {
    _es_wrapper_prepend_path
}
if [[ " ${precmd_functions[*]-} " != *" _es_wrapper_guard "* ]]; then
    precmd_functions+=(_es_wrapper_guard)
fi

_es_wrapper_vm_hook() {
    if [[ -f .nvmrc || -f .node-version ]]; then
        type nvm &>/dev/null && nvm use --silent 2>/dev/null
    fi

    if [[ -f .python-version ]]; then
    fi
}
if [[ -n "$ZSH_VERSION" ]]; then
    autoload -U add-zsh-hook 2>/dev/null
    add-zsh-hook chpwd _es_wrapper_vm_hook
    _es_wrapper_vm_hook
fi
