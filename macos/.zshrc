# setenv is implemented relying on zsh capabilites. So be aware of it.
setenv () {
  local file # prevents overwriting a global var named 'file' in my current term session.
  [[ -f .env ]] && file=".env" || { [[ -f .envrc ]] && file=".envrc"; }

  # The ${file:?} syntax throws an error if 'file' is empty or unset
  # ':' checks if the var is null or unset. '?' exit or print operator.
  : ${file:?"No .env or .envrc found"}

  printf "Sourcing %s...\n" "$file"
  set -a && source "$file" && set +a
}

