# eval "$(starship init zsh)"

#########################################################################################
# BEGIN VCS INFO
#
# Load version control information module
autoload -Uz vcs_info

# this has been taken and modified based on the example shown here:
# https://github.com/zsh-users/zsh/blob/master/Misc/vcs_info-examples#L44
function precmd() {
    vcs_info

    prompt_newline=$'\n%{\r%}'

    if [[ -z ${vcs_info_msg_0_} ]]; then
        PS1="${prompt_newline}%B%5~%b %#${prompt_newline}> "
    else
        PS1="${prompt_newline}%B%3~${vcs_info_msg_0_}%b %#${prompt_newline}> "
    fi
}

function +vi-git-ahead-behind() {
    local ahead behind
    local -a gitstatus

    # Exit early in case the worktree is on a detached HEAD
    git rev-parse ${hook_com[branch]}@{upstream} >/dev/null 2>&1 || return 0

    local -a ahead_and_behind=(
        $(git rev-list --left-right --count HEAD...${hook_com[branch]}@{upstream} 2>/dev/null)
    )

    ahead=${ahead_and_behind[1]}
    behind=${ahead_and_behind[2]}

    (( $ahead )) && gitstatus+=( "+${ahead}" )
    (( $behind )) && gitstatus+=( "-${behind}" )

    hook_com[misc]+=${(j:/:)gitstatus}
}

function +vi-git-status-counts() { 
    local status_output
    status_output=$(git status --porcelain 2>/dev/null)
    
    local stash_count=$(git stash list 2>/dev/null | wc -l | tr -d ' ')
    
    local -a counts
    
    if [[ -n $status_output ]]; then
        # Staged: A, M, D, R, C in the FIRST column
        local staged=$(echo "$status_output" | grep -c '^[AMDRE]')
        # Modified: M in the SECOND column
        local modified=$(echo "$status_output" | grep -c '^.M')
        # Deleted: D in the FIRST or SECOND column
        local deleted=$(echo "$status_output" | grep -c '^.D')
        # Untracked: ??
        local untracked=$(echo "$status_output" | grep -c '??')

        (( $staged > 0 ))    && counts+=( "++(${staged})" )
        (( $modified > 0 ))  && counts+=( "M${modified}" )
        (( $untracked > 0 )) && counts+=( "U${untracked}" )
        (( $deleted > 0 ))   && counts+=( "D${deleted}" )
    fi

    # Check stash regardless of porcelain output
    (( $stash_count > 0 )) && counts+=( "S${stash_count}" ) # 

    # Append to misc so it shows up via %m
    if (( ${#counts} > 0 )); then
        hook_com[misc]+=" [${(j: :)counts}]"
    fi
}

zstyle ':vcs_info:*' check-for-changes true
zstyle ':vcs_info:git*' formats " - %b %m " 
zstyle ':vcs_info:git*+set-message:*' hooks git-ahead-behind git-status-counts

#
# END VCS INFO
#########################################################################################


